# Server .env for Classone-Discovery — setup.sh copies this to /opt/classone/app/.env (mode 600).
# Fill in the keys marked FILL from your local .env. Everything else is already right for the server.

NODE_ENV=production
PORT=4000
# setup.sh rewrites this to the site address.
CORS_ORIGINS=https://localhost

# MongoDB runs on the same machine, reachable only from it.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=classone_automation
DB_PROVIDER=mongo

SCRAPER_SERVICE_URL=http://127.0.0.1:8000
SCRAPER_PORT=8000
SCRAPER_USER_AGENT=ClassOneSalesBot/1.0 (+mailto:saiethihaschanda@gmail.com; purpose: academic lead research)
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_ENABLE_BROWSER=true
VIDWAN_ENABLED=false
VIDWAN_CONCURRENCY=1
VIDWAN_DELAY_MS=1500

# FILL: scoring model keys (Jev takes priority over OpenAI when both are set).
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_RUN_BUDGET_USD=5
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_RUN_BUDGET_USD=5

# FILL: OpenAlex key (free, 10x the daily allowance).
OPENALEX_MAILTO=saiethihaschanda@gmail.com
OPENALEX_API_KEY=

EMAIL_PROVIDER=ethereal
EMAIL_FROM_NAME=Class One Systems
EMAIL_FROM_ADDRESS=sales@classone-systems.example

# Pipelines are started by hand from the Faculty page; no scheduled runs.
CRON_ENABLED=false
FOLLOWUP_WAIT_DAYS=6
FOLLOWUP_MAX_ATTEMPTS=2

# The frontend is built with VITE_API_BASE_URL=/api (same site), set by setup.sh / update.sh.
