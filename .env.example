# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored. Never commit real keys.
# All three services (backend, scraper-service, frontend) read this one file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MongoDB Atlas free-tier (M0) connection string.
# Get it from: Atlas -> your cluster -> Connect -> Drivers -> copy the URI,
# then replace <db_password> with your real DB user password.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=classone_automation

# Which database implementation the repository layer uses.
# `mongo` now; `firestore` after the later migration.
DB_PROVIDER=mongo

# --- Backend --------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Scraper service (Python/FastAPI) -------------------------------------
SCRAPER_SERVICE_URL=http://localhost:8000
SCRAPER_PORT=8000
# Sent on every outbound scrape request so site owners can identify/contact us.
SCRAPER_USER_AGENT=ClassOneSalesBot/1.0 (+mailto:saiethihaschanda@gmail.com; purpose: academic lead research)
# Minimum delay between requests to the SAME domain, in milliseconds.
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_RESPECT_ROBOTS=true

# --- OpenAI ---------------------------------------------------------------
# See README "OpenAI API setup" for step-by-step instructions.
OPENAI_API_KEY=sk-REPLACE_ME
# Cheap model: classification, scoring, summarisation, reply detection.
OPENAI_MODEL_CHEAP=gpt-4o-mini
# Strong model: first-touch outreach email drafts only.
OPENAI_MODEL_STRONG=gpt-4o
# Abort a discovery run and raise a critical alert above this USD spend.
OPENAI_RUN_BUDGET_USD=5

# --- Jev (TypeSafe AI) ------------------------------------------------------
# Typed-decision model used for relevance scoring INSTEAD of OpenAI when set —
# takes priority over OPENAI_API_KEY above. Get a key at https://console.typesafe.ai/.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_RUN_BUDGET_USD=5

# --- Gemini (Google AI Studio) ---------------------------------------------
# Free-tier experiment, used INSTEAD of OpenAI/Jev when set and they are not —
# takes lowest priority of the three paid-provider slots. Get a free key at
# https://aistudio.google.com/apikey. Free tier can't web-search (no backfill);
# that needs the paid tier — same key, billing enabled on the Google Cloud project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Tried in order when GEMINI_MODEL is busy or out of quota (each model has its own free quota)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Researchers scored per Gemini call (1 = no batching)
AI_SCORE_BATCH_SIZE=6

# --- Email ----------------------------------------------------------------
# `ethereal` = disposable sandbox inboxes, no signup, preview link per email.
# `gmail`    = real Gmail API (Phase 6, needs the OAuth vars below).
EMAIL_PROVIDER=ethereal
EMAIL_FROM_NAME=Class One Systems
EMAIL_FROM_ADDRESS=sales@classone-systems.example

# EMAIL_PROVIDER=gmail only. Create a Desktop-app OAuth client in Google Cloud
# Console (enable the Gmail API first), set the two below, then run
# `npm run gmail:auth` once to obtain GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Sign-in (Firebase Auth) + roles --------------------------------------
# Off by default in development (a synthetic admin is used); defaults ON when
# NODE_ENV=production. Firebase project: ClassOne Discovery (classone-automation).
AUTH_ENABLED=false
FIREBASE_PROJECT_ID=classone-automation
# These addresses become admins on first sign-in; everyone else starts "pending".
ADMIN_EMAILS=
# Shared secret for server-side scripts (rosterOrchestrator.py), sent as X-Internal-Token.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
# Firebase web config (public, safe in the browser) — Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=classone-automation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=classone-automation
VITE_FIREBASE_APP_ID=

# --- External data sources ------------------------------------------------
# OpenAlex "polite pool": supplying an email gets faster, more reliable service. Free.
OPENALEX_MAILTO=saiethihaschanda@gmail.com
# OpenAlex bills per call: 10 credits for a search call, 1 for a filter-only call,
# free for single-record lookups. Without a key: 1,000 credits ($0.10) per day.
# A FREE API key (sign up at https://openalex.org, no card needed) raises that
# 10x to $1.00 per day; prepaid usage in $1 steps is available at
# https://openalex.org/pricing once the free allowance runs out.
OPENALEX_API_KEY=

# --- Scheduling (cron syntax) ---------------------------------------------
# Weekly discovery run: Mondays 02:00.
CRON_DISCOVERY_SCHEDULE=0 2 * * 1
# Follow-up due-check: daily 09:00.
CRON_FOLLOWUP_CHECK_SCHEDULE=0 9 * * *
# Set false to stop cron jobs auto-starting (useful while developing).
CRON_ENABLED=false

# --- Follow-up policy -----------------------------------------------------
FOLLOWUP_WAIT_DAYS=6
FOLLOWUP_MAX_ATTEMPTS=2
# How often the follow-up check runs (minutes); it only drafts, never sends
FOLLOWUP_CHECK_MINUTES=10
# How often the sales inbox is read for replies and enquiries (seconds; 0 = off)
INBOX_POLL_SECONDS=60
# Most campaign emails sent per day across all campaigns (Gmail: ~500/day personal, ~2,000 Workspace)
CAMPAIGN_DAILY_CAP=300
# Conversations: a message counts as overdue after this many hours without a real answer
OVERDUE_HOURS=48
# Auto-reply people: hours after it becomes overdue before the AI holding reply goes out (a person can still answer first)
AUTO_REPLY_DELAY_HOURS=4
# Daily "replies overdue" digest to sales and admin users (India time, HH:MM)
DIGEST_TIME=09:30
# Signs the "Review & send" links in team emails (defaults to INTERNAL_API_TOKEN)
# ACTION_LINK_SECRET=
# Where people open the app — used for links in notification emails (defaults to the first CORS origin)
# APP_URL=https://crm.example.com

# --- Frontend (Vite requires the VITE_ prefix to expose a var to the browser) ---
VITE_API_BASE_URL=http://localhost:4000/api

# --- Scraper escalation tiers ---------------------------------------------
# Tier 2: render pages in a real browser (Playwright). Needed for
# client-side-rendered faculty directories, which look identical to empty pages
# over plain HTTP. Costs ~10-30x a plain GET, so it only runs when the cheap
# fetch came back unusable.
SCRAPER_ENABLE_BROWSER=true

# Tier 3: route the browser through a proxy. Measured: most 403s survive a real
# browser with a real TLS fingerprint, meaning they key on IP reputation — a
# different egress IP is the only thing that changes the outcome. Requires a
# proxy provider; leave blank to disable.
SCRAPER_PROXY_URL=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# Vidwan (vidwan.inflibnet.ac.in), searched by the roster build. false = no
# request is sent: the build skips the source and the scraper refuses its Vidwan
# endpoints. Off since 7 Nov 2026, after Vidwan began refusing our connection.
VIDWAN_ENABLED=false
